# Ignore the actual config file with API key
config.ini
# Ignore Videos directory (simulation outputs)
Videos/
# Ignore Haifa Samples directory
Haifa Samples/
map_clean_haifa.png
# Ignore raw telemetry-labeled validation datasets (multi-GB, downloaded manually -- see CLAUDE.md)
Datasets/
# Ignore per-video mask/altitude caches (regenerable, video-specific -- see CLAUDE.md)
masks/
# Ignore build output (compiled binaries, CMake cache) -- was previously tracked, untracked now
build/
build*/
# Ignore project reference/notes file (kept local, not committed)
CLAUDE.md
AGENTS.md
STRATEGY.md
INVESTIGATION_LOG.md
# Ignore UAV-VisLoc converted satellite maps (regenerable via
# scripts/convert_uavvisloc_satellite.py -- unlike Haifa/Jerusalem/Manhattan's
# Google-Maps-fetched maps, these aren't capped by an API size limit and can
# be 100s of MB, especially at a finer --target-mpp)
Images/map_clean_uavvisloc_*.png
# Ignore Esri World Imagery satellite maps (same reasoning -- regenerable via
# scripts/fetch_esri_imagery.py, can be tens to 100s of MB)
Images/map_clean_esri_*.png
# Ignore exported ONNX model weights (regenerable via
# scripts/export_retrieval_backbone.py -- STRATEGY.md Phase 2 learned retrieval)
models/
# Ignore fine-tuning checkpoints (large binary training artifacts, regenerable
# via scripts/finetune_retrieval_backbone.py -- STRATEGY.md Phase 2 fine-tuning)
checkpoints/
# Ignore Python bytecode cache (scripts/run_benchmark.py importing
# scripts/evaluate_ground_truth.py as a module generates this)
__pycache__/

